<Window x:Class="ScrollVideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Scroll Video Player"
        Width="1280" Height="820" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#080A0F"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Background="#080A0F">
        <vlc:VideoView x:Name="VideoSurface">
            <Grid x:Name="OverlayRoot"
                  Background="Transparent"
                  PreviewMouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="Overlay_MouseLeftButtonUp"
                  PreviewMouseWheel="Overlay_MouseWheel"
                  TouchDown="Overlay_TouchDown"
                  TouchMove="Overlay_TouchMove"
                  TouchUp="Overlay_TouchUp">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="17,12"
                        Background="#D9111520"
                        BorderBrush="#394253" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="12" Background="#6659E8" Margin="0,0,11,0">
                                <TextBlock Text="▶" FontSize="17" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" MaxWidth="520">
                                <TextBlock Text="SCROLL VIDEO PLAYER" FontSize="12" FontWeight="Bold"
                                           Foreground="#B6BDFD" />
                                <TextBlock x:Name="HeaderFolder" Text="Choose a folder to start"
                                           FontSize="13" Foreground="#E6EAF2" />
                            </StackPanel>
                            <Border Margin="15,0,0,0" Padding="9,5" CornerRadius="8"
                                    Background="#242B39" VerticalAlignment="Center">
                                <TextBlock x:Name="VideoCountText" Text="0 videos" FontSize="12"
                                           Foreground="#C5CCDA" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Open folder" Style="{StaticResource AccentButton}"
                                    Click="OpenFolder_Click" />
                            <Button Content="Playlist" Style="{StaticResource QuietButton}"
                                    Click="TogglePlaylist_Click" />
                            <Button Content="Settings" Style="{StaticResource QuietButton}"
                                    Click="Settings_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main canvas -->
                <Grid Grid.Row="1" ClipToBounds="True">
                    <Border x:Name="EmptyState"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="440" Padding="34" CornerRadius="20"
                            Background="#E9161C29" BorderBrush="#46516A" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="20"
                                    Background="#2D2C58" Margin="0,0,0,18">
                                <TextBlock Text="▶" FontSize="27" Foreground="#A8A0FF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Your videos, one after another"
                                       FontSize="23" FontWeight="Bold" TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Open a folder to start an uninterrupted video feed. Scroll up for the next clip, or swipe left to remove the current one."
                                       Margin="0,10,0,20" FontSize="13" Foreground="#AEB7C8"
                                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" />
                            <Button Content="Choose video folder" Style="{StaticResource AccentButton}"
                                    Padding="22,11" Click="OpenFolder_Click" />
                            <TextBlock Text="Supports common formats including MP4, MKV, MOV, AVI and WebM"
                                       Margin="0,16,0,0" FontSize="11" Foreground="#8792A7"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="PlaylistPanel"
                            Width="310" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Margin="14,14,0,14" CornerRadius="15"
                            Background="#F0151A24" BorderBrush="#3C4659" BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="15,13,11,8">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="PLAY QUEUE" FontSize="11" FontWeight="Bold"
                                               Foreground="#AFA8FF" />
                                    <TextBlock Text="Select a video to jump to it" FontSize="11"
                                               Foreground="#AAB3C2" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Content="✕" Padding="8,4" Margin="0"
                                        HorizontalAlignment="Right" Click="TogglePlaylist_Click" />
                            </DockPanel>
                            <ListBox x:Name="VideoList" Grid.Row="1"
                                     SelectionChanged="VideoList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FolderName}" FontSize="10"
                                                       Foreground="#98A3B5" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="PlaylistFooter" Grid.Row="2"
                                       Text="Scroll ↑ next  ·  Swipe ← delete"
                                       Margin="14,9,14,13" FontSize="10"
                                       Foreground="#8793A9" />
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="20,0,20,18" Padding="12,7" CornerRadius="20"
                            Background="#B90D111A" BorderBrush="#30394B" BorderThickness="1">
                        <TextBlock x:Name="StatusText"
                                   Text="Scroll ↑ next video     ·     Swipe ← delete     ·     Space pause"
                                   FontSize="11" Foreground="#D5DBE7" />
                    </Border>
                </Grid>

                <!-- Player controls -->
                <Border Grid.Row="2" Padding="18,9,18,14"
                        Background="#E9111520"
                        BorderBrush="#394253" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="11"
                                       Foreground="#CFD5E1" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Slider x:Name="SeekSlider" Grid.Column="1"
                                    Minimum="0" Maximum="1" Value="0"
                                    ValueChanged="SeekSlider_ValueChanged"
                                    PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                    ToolTip="Seek" />
                            <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00"
                                       FontSize="11" Foreground="#CFD5E1"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⏮" Width="43" Padding="8,8"
                                        ToolTip="Previous video (or restart current)"
                                        Click="Previous_Click" />
                                <Button x:Name="PlayPauseButton" Content="▶  Play" MinWidth="76"
                                        Style="{StaticResource AccentButton}" Click="PlayPause_Click" />
                                <Button Content="⏭" Width="43" Padding="8,8"
                                        ToolTip="Next video" Click="Next_Click" />
                                <Button Content="Delete" Style="{StaticResource QuietButton}"
                                        Click="Delete_Click" />
                                <Button Content="Audio" Style="{StaticResource QuietButton}"
                                        Click="AudioTracks_Click" />
                                <Button Content="Subtitles" Style="{StaticResource QuietButton}"
                                        Click="SubtitleTracks_Click" />
                                <Button Content="Fit ▾" Style="{StaticResource QuietButton}"
                                        Click="VideoMode_Click" />
                                <Button x:Name="SpeedButton" Content="1.0×" Style="{StaticResource QuietButton}"
                                        Click="Speed_Click" />
                                <Button Content="Snapshot" Style="{StaticResource QuietButton}"
                                        Click="Snapshot_Click" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MuteButton" Content="🔊" Width="42" Padding="7,8"
                                        ToolTip="Mute / unmute" Click="Mute_Click" />
                                <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100"
                                        Value="80" ValueChanged="VolumeSlider_ValueChanged"
                                        ToolTip="Volume" />
                                <Button Content="⛶ Fullscreen" Style="{StaticResource QuietButton}"
                                        Click="FullScreen_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</Window>
